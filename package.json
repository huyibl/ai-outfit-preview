{
  "name": "ai-outfit-preview",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "typecheck:server": "tsc -p tsconfig.node.json",
    "serve": "npm run build && tsx server/index.ts",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "demo:video": "playwright test tests/demo.spec.ts && node scripts/copy-demo-video.mjs",
    "generate:models": "node scripts/generate-models.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^2.1.9"
  }
}
