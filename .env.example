# 把下面「你的密钥」换成平台复制出来的 Key，保存即可。
# 没有 Key 时，页面会用本地人台拼贴，不报错。

# 阿里云百炼虚拟试衣（默认路径，北京地域 Key）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE=https://dashscope.aliyuncs.com
DASHSCOPE_TRYON_MODEL=aitryon-plus

# 硅基流动：文生图 / 图生图兜底
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.siliconflow.cn/v1
# 文生图（Kolors 免费）
IMAGE_TXT_MODEL=Kwai-Kolors/Kolors
# 图生图：试衣失败或手动选择时的分层换装（约 ¥0.30/件）
IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509

# ---- 部署配置（做成产品/接入别的产品时使用）----
# 访问令牌：设置后所有 /api 请求需带 Authorization: Bearer <token>；不设置则仅允许本机调用
ACCESS_TOKEN=
# 允许跨域调用的来源（逗号分隔，接入方前端域名）；* 表示全部放开
ALLOWED_ORIGINS=
# 独立服务端口（npm run start）
PORT=8787

# ---- AI 搭配师 / 质检（v3.2，复用 IMAGE_API_KEY 调 SiliconFlow）----
# 搭配师文本模型（便宜即可）
STYLIST_MODEL=Qwen/Qwen2.5-7B-Instruct
# 质检/打标视觉模型
QC_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# 搭配方案是否允许外套（外套走第二轮叠加；实测未通过前可设 0）
STYLIST_ALLOW_OUTER=1
# 每日试衣预算闸（元），0 为关闭；单价按 TRYON_UNIT_YUAN 估算计费
DAILY_BUDGET_YUAN=50
TRYON_UNIT_YUAN=0.5
# 图片中转域名白名单（逗号分隔后缀）
RELAY_HOST_SUFFIXES=aliyuncs.com,siliconflow.cn,siliconflow.com

# ---- 可观测性与配额（v3.3）----
# 告警 webhook（企业微信机器人）；降级率>30% 或试衣 P95>60s 时推送，可不填
ALERT_WEBHOOK=
# 每 IP 每日试衣软配额（超了只提示不拦截；硬防线=前端设备配额+全局预算闸）
TRYON_DAILY_PER_IP=30
